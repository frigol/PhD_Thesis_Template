% ============================================================
%  thesis.sty — Preset personalizzato per tesi
% ============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{thesis}[2026/03/24 Preset per tesi]

% ------------------------------------------------------------
%  Codifica e lingua
% ------------------------------------------------------------
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[english]{babel}
%\RequirePackage[italian]{babel}

% ------------------------------------------------------------
%  Font — Palatino + matematica abbinata
% ------------------------------------------------------------
\RequirePackage{newpxtext}
\RequirePackage{newpxmath}
\RequirePackage{microtype}        % migliora la giustificazione

% ------------------------------------------------------------
%  Margini e geometria
% ------------------------------------------------------------
\RequirePackage{geometry}
\geometry{
    a4paper,
    top        = 3cm,
    bottom     = 3cm,
    inner      = 4cm,
    outer      = 3cm,
    headheight = 25.68448pt,
    headsep    = 12pt
}

% ------------------------------------------------------------
%  Equivalente di cleardoublepage=empty
% ------------------------------------------------------------
\renewcommand{\cleardoublepage}{
    \clearpage
    \if@twoside
        \ifodd\c@page\else
            \hbox{}
            \thispagestyle{empty}
            \newpage
        \fi
    \fi
}

% ------------------------------------------------------------
%  Interlinea 1.5 (norma esplicita)
% ------------------------------------------------------------
\RequirePackage{setspace}
\onehalfspacing

% ------------------------------------------------------------
%  Rientro paragrafi — 2pt, non al primo paragrafo di sezione
% ------------------------------------------------------------
\RequirePackage{indentfirst}
\setlength{\parindent}{2pt}

% ------------------------------------------------------------
%  Corpo testo 12pt — impostato nel \documentclass
%  Note a piè di pagina 10pt
% ------------------------------------------------------------
\RequirePackage[hang]{footmisc}
\renewcommand{\footnotesize}{\fontsize{10}{12}\selectfont}
\setlength{\footnotemargin}{1.5em}

% ------------------------------------------------------------
%  Allineamento giustificato (default LaTeX, esplicitato)
% ------------------------------------------------------------
\RequirePackage{ragged2e}

% ------------------------------------------------------------
%  Intestazioni e piè di pagina
% ------------------------------------------------------------
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE]{\small\nouppercase{\leftmark}}
\fancyhead[RO]{\small\nouppercase{\rightmark}}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0.4pt}

\fancypagestyle{plain}{
    \fancyhf{}
    \fancyfoot[C]{\thepage}
    \renewcommand{\headrulewidth}{0pt}
}

% Pagine non numerate (abstract)
\fancypagestyle{nonumerato}{
    \fancyhf{}
    \renewcommand{\headrulewidth}{0pt}
}

% ------------------------------------------------------------
%  Stile capitoli e sezioni
% ------------------------------------------------------------
\RequirePackage{titlesec}

\titleformat{\chapter}
    {\normalfont\fontsize{15}{17}\bfseries}
    {\thechapter.}{1em}{}
\titlespacing*{\chapter}{0pt}{30pt}{20pt}

\titleformat{\section}
    {\normalfont\fontsize{12}{14}\bfseries}{\thesection}{1em}{}

\titleformat{\subsection}
    {\normalfont\fontsize{12}{14}\bfseries}{\thesubsection}{1em}{}

% ------------------------------------------------------------
%  Numeri romani frontmatter maiuscoli
% ------------------------------------------------------------
\let\oldfrontmatter\frontmatter
\renewcommand{\frontmatter}{
    \oldfrontmatter
    \renewcommand{\thepage}{\Roman{page}}   % ← romani maiuscoli
    \pagestyle{fancy}
    \fancyhf{}
    \fancyhead[LE]{\small\nouppercase{\leftmark}}   % ← solo testo, no numero
    \fancyhead[RO]{\small\nouppercase{\leftmark}}   % ← stesso su entrambi i lati
    \fancyfoot[C]{\thepage}
}
\let\oldmainmatter\mainmatter
\renewcommand{\mainmatter}{
    \oldmainmatter
    \pagestyle{fancy}
    \fancyhf{}
    \fancyhead[LE]{\small\nouppercase{\leftmark}}   % ← capitolo
    \fancyhead[RO]{\small\nouppercase{\rightmark}}  % ← sezione
    \fancyfoot[C]{\thepage}
}

% ------------------------------------------------------------
%  Rimozione punto dopo i numeri di sezione
% ------------------------------------------------------------
\renewcommand{\thesection}{\arabic{chapter}.\arabic{section}}
\renewcommand{\thesubsection}{\thesection.\arabic{subsection}}

% ------------------------------------------------------------
%  Citazioni brevi — virgolette caporali « »
% ------------------------------------------------------------
\RequirePackage{csquotes}
\MakeOuterQuote{"}   % " diventa automaticamente « »

% Citazioni lunghe (3+ righe) — infratesto corpo 11, rientro
\newenvironment{citazionelonga}{%
    \par\addvspace{\baselineskip}
    \small\fontsize{11}{13}\selectfont
    \begin{quotation}
    \noindent
}{%
    \end{quotation}
    \addvspace{\baselineskip}
}

% ------------------------------------------------------------
%  Nomi autori in maiuscoletto (per bibliografia)
% ------------------------------------------------------------
\newcommand{\autore}[1]{\textsc{#1}}

% ------------------------------------------------------------
%  Risorse di rete — formato <url> (data cons.)
% ------------------------------------------------------------
\RequirePackage{url}
\newcommand{\risorserete}[2]{\textless\url{#1}\textgreater\ (ultima cons.\ #2)}

% ------------------------------------------------------------
%  Pacchetti utili per la tesi
% ------------------------------------------------------------
\RequirePackage{graphicx}         % immagini
\RequirePackage{booktabs}         % tabelle eleganti
\RequirePackage{caption}          % didascalie personalizzate
\captionsetup{
    justification = centering,
    labelsep      = colon,
    textfont      = normalfont,
}
\RequirePackage[
    style        = authortitle,
    backend      = biber,
    autocite     = footnote,
    ibidtracker  = false,
    pagetracker  = false,
    citetracker  = true,
]{biblatex}

% ------------------------------------------------------------
%  Personalizzazione stile bibliografico — norme Vivaldi
% ------------------------------------------------------------

% Nome e Cognome entrambi in maiuscoletto — ordine: Nome Cognome
\renewcommand{\mkbibnamefamily}[1]{\textsc{#1}}
\renewcommand{\mkbibnamegiven}[1]{\textsc{#1}}
\renewcommand{\mkbibnameprefix}[1]{\textsc{#1}}
\DeclareNameAlias{sortname}{given-family}
\DeclareNameAlias{default}{given-family}

% Separatore tra autori: " – "
\renewcommand{\multinamedelim}{\addspace\textendash\addspace}
\renewcommand{\finalnamedelim}{\addspace\textendash\addspace}

% Punto finale nelle note
\renewcommand{\finentrypunct}{.}

% Titolo in corsivo (non tra virgolette)
\DeclareFieldFormat{title}{\textit{#1}}
\DeclareFieldFormat[article]{title}{\textit{#1}}
\DeclareFieldFormat{booktitle}{\textit{#1}}

% Riviste tra virgolette caporali, non in corsivo
\DeclareFieldFormat{journaltitle}{«#1»}

% ------------------------------------------------------------
%  Citazione completa — prima occorrenza
% ------------------------------------------------------------
\newbibmacro*{vivaldi:full}{%
    \printnames{author}%
    \setunit{\addcomma\addspace}%
    \printfield{title}%
    % Curatore se presente
    \ifnameundef{editor}{}{%
        \setunit{\addcomma\addspace}%
        a cura di \printnames{editor}}%
    \setunit{\addcomma\addspace}%
    \ifentrytype{article}{%
        % Articolo: rivista, volume/numero, anno, pp. solo se presenti
        \printfield{journaltitle}%
        \setunit{\addspace}%
        \printfield{volume}%
        \iffieldundef{number}{}{\printtext{/}\printfield{number}}%
        \setunit{\addcomma\addspace}%
        \printfield{year}%
        \iffieldundef{pages}{}{%
            \printtext{\addcomma\addspace pp.\addspace}%
            \printfield[noformat]{pages}}%
    }{%
        % Monografia: luogo, editore, anno, collana se presente
        \printlist{location}%
        \setunit{\addcomma\addspace}%
        \printlist{publisher}%
        \setunit{\addcomma\addspace}%
        \printfield{year}%
        \iffieldundef{series}{}{%
            \addspace(\printfield{series}%
            \iffieldundef{number}{}{\addcomma\addspace\printfield{number}}%
            )}%
    }%
}

% ------------------------------------------------------------
%  Citazione abbreviata — occorrenze successive
%  Formato: COGNOME, Titolo abbreviato cit.
% ------------------------------------------------------------
\newbibmacro*{vivaldi:short}{%
    \printnames[family]{labelname}%
    \setunit{\addcomma\addspace}%
    \iffieldundef{shorttitle}
        {\printfield{title}}
        {\printfield{shorttitle}}%
    \addspace cit.%
}

% Hook interno per prima/successive citazioni
\renewbibmacro*{cite}{%
    \ifciteseen
        {\usebibmacro{vivaldi:short}}
        {\usebibmacro{vivaldi:full}}%
}

% ------------------------------------------------------------
%  Rimozione campi non necessari dalla bibliografia finale
% ------------------------------------------------------------
\AtEveryBibitem{%
    \clearfield{issn}%
    \clearfield{isbn}%
    \clearfield{doi}%
    \clearfield{eprint}%
    \clearfield{eprinttype}%
    \clearfield{abstract}%
    \clearfield{note}%
    \clearfield{file}%
    \clearfield{keywords}%
    \clearfield{language}%
    % url e urldate solo per risorse online
    \ifentrytype{online}{}{\clearfield{url}\clearfield{urldate}}%
}

\RequirePackage{hyperref}         % link e PDF metadata
\hypersetup{
    colorlinks  = true,
    linkcolor   = black,
    citecolor   = black,
    urlcolor    = blue
}

\graphicspath{{graphics/}}          % directory immagini

% ------------------------------------------------------------
%  Altri pacchetti personali
% ------------------------------------------------------------
\RequirePackage{lipsum}         % testo segnaposto
\RequirePackage{sidecap}        % didascalia lato immagine
\RequirePackage{wrapfig}        % testo scorre attorno immagine
\RequirePackage{pdfpages}       % importa PDF
\RequirePackage{listings}       % importa codice
\RequirePackage{xcolor}

\lstset{
    basicstyle    = \ttfamily\small,
    keywordstyle  = \color{blue}\bfseries,
    commentstyle  = \color{gray}\itshape,
    stringstyle   = \color{red},
    numbers       = left,
    numberstyle   = \tiny\color{gray},
    stepnumber    = 1,
    frame         = single,
    breaklines    = true,
    captionpos    = b,
}

\endinput