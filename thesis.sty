% ============================================================
%  thesis.sty — Preset personalizzato per tesi
% ============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{thesis}[2026/03/24 Preset per tesi]

% ------------------------------------------------------------
%  Codifica e lingua
% ------------------------------------------------------------
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage[english]{babel}
%\RequirePackage[italian]{babel}

% ------------------------------------------------------------
%  Font — Palatino + matematica abbinata
% ------------------------------------------------------------
\RequirePackage{newpxtext}
\RequirePackage{newpxmath}
\RequirePackage{microtype}        % migliora la giustificazione

% ------------------------------------------------------------
%  Margini e geometria
% ------------------------------------------------------------
\RequirePackage{geometry}
\geometry{
    a4paper,
    top        = 3cm,
    bottom     = 3cm,
    inner      = 4cm,
    outer      = 3cm,
    headheight = 25.68448pt,
    headsep    = 12pt
}

% ------------------------------------------------------------
%  Equivalente di cleardoublepage=empty
% ------------------------------------------------------------
\renewcommand{\cleardoublepage}{
    \clearpage
    \if@twoside
        \ifodd\c@page\else
            \hbox{}
            \thispagestyle{empty}
            \newpage
        \fi
    \fi
}

% ------------------------------------------------------------
%  Interlinea 1.5 (norma esplicita)
% ------------------------------------------------------------
\RequirePackage{setspace}
\onehalfspacing

% ------------------------------------------------------------
%  Rientro paragrafi — 2pt, non al primo paragrafo di sezione
% ------------------------------------------------------------
\RequirePackage{indentfirst}
\setlength{\parindent}{2pt}

% ------------------------------------------------------------
%  Corpo testo 12pt — impostato nel \documentclass
%  Note a piè di pagina 10pt
% ------------------------------------------------------------
\RequirePackage[hang]{footmisc}
\renewcommand{\footnotesize}{\fontsize{10}{12}\selectfont}
\setlength{\footnotemargin}{1.5em}

% ------------------------------------------------------------
%  Allineamento giustificato (default LaTeX, esplicitato)
% ------------------------------------------------------------
\RequirePackage{ragged2e}

% ------------------------------------------------------------
%  Intestazioni e piè di pagina
% ------------------------------------------------------------
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[LE]{\small\nouppercase{\leftmark}}
\fancyhead[RO]{\small\nouppercase{\rightmark}}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0.4pt}

\fancypagestyle{plain}{
    \fancyhf{}
    \fancyfoot[C]{\thepage}
    \renewcommand{\headrulewidth}{0pt}
}

% Unnumbered pages
\fancypagestyle{nonumbered}{
    \fancyhf{}
    \renewcommand{\headrulewidth}{0pt}
}

% ------------------------------------------------------------
%  Stile capitoli e sezioni
% ------------------------------------------------------------
\RequirePackage{titlesec}

\titleformat{\chapter}
    {\normalfont\fontsize{15}{17}\bfseries}
    {\thechapter.}{1em}{}
\titlespacing*{\chapter}{0pt}{30pt}{20pt}

\titleformat{\section}
    {\normalfont\fontsize{12}{14}\bfseries}{\thesection}{1em}{}

\titleformat{\subsection}
    {\normalfont\fontsize{12}{14}\bfseries}{\thesubsection}{1em}{}

% ------------------------------------------------------------
%  Numeri romani frontmatter maiuscoli
% ------------------------------------------------------------
\let\oldfrontmatter\frontmatter
\renewcommand{\frontmatter}{
    \oldfrontmatter
    \renewcommand{\thepage}{\Roman{page}}   % ← romani maiuscoli
    \pagestyle{fancy}
    \fancyhf{}
    \fancyhead[LE]{\small\nouppercase{\leftmark}}   % ← solo testo, no numero
    \fancyhead[RO]{\small\nouppercase{\leftmark}}   % ← stesso su entrambi i lati
    \fancyfoot[C]{\thepage}
}
\let\oldmainmatter\mainmatter
\renewcommand{\mainmatter}{
    \oldmainmatter
    \pagestyle{fancy}
    \fancyhf{}
    \fancyhead[LE]{\small\nouppercase{\leftmark}}   % ← capitolo
    \fancyhead[RO]{\small\nouppercase{\rightmark}}  % ← sezione
    \fancyfoot[C]{\thepage}
}

% ------------------------------------------------------------
%  Rimozione punto dopo i numeri di sezione
% ------------------------------------------------------------
\renewcommand{\thesection}{\arabic{chapter}.\arabic{section}}
\renewcommand{\thesubsection}{\thesection.\arabic{subsection}}

% ------------------------------------------------------------
%  Profondità indice — solo capitoli e sezioni, non sottosezioni
%  (0=chapter, 1=section, 2=subsection: default classe book è 2)
% ------------------------------------------------------------
\setcounter{tocdepth}{1}

% ------------------------------------------------------------
%  Citazioni brevi — virgolette caporali « »
% ------------------------------------------------------------
\RequirePackage{csquotes}
\MakeOuterQuote{"}   % " diventa automaticamente « »

% Citazioni lunghe (3+ righe) — infratesto corpo 11, rientro
\newenvironment{longcit}{%
    \par\addvspace{\baselineskip}
    \small\fontsize{11}{13}\selectfont
    \begin{quotation}
    \noindent
}{%
    \end{quotation}
    \addvspace{\baselineskip}
}

% ------------------------------------------------------------
%  Author names in small caps (for manual references)
% ------------------------------------------------------------
\newcommand{\authorname}[1]{\textsc{#1}}

% ------------------------------------------------------------
%  Web resources — format <url> (last accessed)
% ------------------------------------------------------------
\RequirePackage{url}
\newcommand{\webresource}[2]{\textless\url{#1}\textgreater\ (ultima cons.\ #2)}

% ------------------------------------------------------------
%  Pacchetti utili per la tesi
% ------------------------------------------------------------
\RequirePackage{graphicx}         % immagini
\RequirePackage{booktabs}         % tabelle eleganti
\RequirePackage{caption}          % didascalie personalizzate
\captionsetup{
    justification = centering,
    labelsep      = colon,
    textfont      = normalfont,
}
\RequirePackage[
    style        = authortitle,
    backend      = biber,
    autocite     = footnote,
    ibidtracker  = false,
    pagetracker  = false,
    citetracker  = true,
]{biblatex}

% ------------------------------------------------------------
%  Personalizzazione stile bibliografico — norme Vivaldi
% ------------------------------------------------------------

% Nome e Cognome entrambi in maiuscoletto — ordine: Nome Cognome
\renewcommand{\mkbibnamefamily}[1]{\textsc{#1}}
\renewcommand{\mkbibnamegiven}[1]{\textsc{#1}}
\renewcommand{\mkbibnameprefix}[1]{\textsc{#1}}
\DeclareNameAlias{sortname}{given-family}
\DeclareNameAlias{default}{given-family}

% Separatore tra autori: " – "
\renewcommand{\multinamedelim}{\addspace\textendash\addspace}
\renewcommand{\finalnamedelim}{\addspace\textendash\addspace}

% Punto finale nelle note
\renewcommand{\finentrypunct}{.}

% Titolo in corsivo (non tra virgolette)
\DeclareFieldFormat{title}{\textit{#1}}
\DeclareFieldFormat[article]{title}{\textit{#1}}
\DeclareFieldFormat{booktitle}{\textit{#1}}

% Riviste tra virgolette caporali, non in corsivo
\DeclareFieldFormat{journaltitle}{«#1»}

% ------------------------------------------------------------
%  Testi normativi (@legislation) — titolo in tondo, non corsivo
%  (una legge non è un'opera con titolo descrittivo, cfr. norme
%  su nomi di enti/istituzioni)
% ------------------------------------------------------------
\DeclareFieldFormat[legislation]{title}{#1}

% Driver di bibliografia dedicato — biblatex standard non include
% un driver per @legislation (tipo usato da Zotero per "Statute"),
% quindi và dichiarato esplicitamente per l'elenco finale
\DeclareBibliographyDriver{legislation}{%
    \usebibmacro{bibindex}%
    \usebibmacro{begentry}%
    \printnames{author}%
    \setunit{\addcomma\addspace}%
    \printfield{title}%
    \newunit
    \iffieldundef{number}{}{%
        \printtext{n.\addspace}\printfield{number}%
        \newunit}%
    \printdate%
    \newunit
    \iffieldundef{venue}{}{\printfield{venue}\newunit}%
    \iffieldundef{note}{}{\printfield{note}\newunit}%
    \iffieldundef{url}{}{\usebibmacro{url+urldate}\newunit}%
    \newunit\newblock
    \usebibmacro{finentry}%
}

% ------------------------------------------------------------
%  Citazione completa — prima occorrenza
% ------------------------------------------------------------
\newbibmacro*{vivaldi:full}{%
    \printnames{author}%
    \setunit{\addcomma\addspace}%
    \printfield{title}%
    % Curatore se presente
    \ifnameundef{editor}{}{%
        \setunit{\addcomma\addspace}%
        a cura di \printnames{editor}}%
    \setunit{\addcomma\addspace}%
    \ifentrytype{article}{%
        % Articolo: rivista, volume/numero, anno, pp. solo se presenti
        \printfield{journaltitle}%
        \setunit{\addspace}%
        \printfield{volume}%
        \iffieldundef{number}{}{\printtext{/}\printfield{number}}%
        \setunit{\addcomma\addspace}%
        \printfield{year}%
        \iffieldundef{pages}{}{%
            \printtext{\addcomma\addspace pp.\addspace}%
            \printfield[noformat]{pages}}%
    }{%
    \ifentrytype{online}{%
        % Risorsa online: ente/organizzazione (se presente), poi <url> (ultima cons. data)
        \iffieldundef{organization}{}{%
            \printlist{organization}%
            \setunit{\addcomma\addspace}}%
        \usebibmacro{url+urldate}%
    }{%
    \ifentrytype{legislation}{%
        % Testo normativo: numero, data, nota (es. Gazzetta Ufficiale), url se presente
        \iffieldundef{number}{}{%
            \printtext{n.\addspace}\printfield{number}%
            \setunit{\addcomma\addspace}}%
        \printdate%
        \iffieldundef{venue}{}{%
            \setunit{\addcomma\addspace}\printfield{venue}}%
        \iffieldundef{note}{}{%
            \setunit{\addcomma\addspace}\printfield{note}}%
        \iffieldundef{url}{}{%
            \setunit{\addcomma\addspace}\usebibmacro{url+urldate}}%
    }{%
        % Monografia: luogo, editore, anno, collana se presente
        \printlist{location}%
        \setunit{\addcomma\addspace}%
        \printlist{publisher}%
        \setunit{\addcomma\addspace}%
        \printfield{year}%
        \iffieldundef{series}{}{%
            \addspace(\printfield{series}%
            \iffieldundef{number}{}{\addcomma\addspace\printfield{number}}%
            )}%
    }%
    }%
    }%
}

% ------------------------------------------------------------
%  Citazione abbreviata — occorrenze successive
%  Formato: COGNOME, Titolo abbreviato cit.
% ------------------------------------------------------------
\newbibmacro*{vivaldi:short}{%
    \printnames[family]{labelname}%
    \setunit{\addcomma\addspace}%
    \iffieldundef{shorttitle}
        {\printfield{title}}
        {\printfield{shorttitle}}%
    \addspace cit.%
}

% Hook interno per prima/successive citazioni
\renewbibmacro*{cite}{%
    \ifciteseen
        {\usebibmacro{vivaldi:short}}
        {\usebibmacro{vivaldi:full}}%
}

% ------------------------------------------------------------
%  Rimozione campi non necessari dalla bibliografia finale
% ------------------------------------------------------------
% ------------------------------------------------------------
%  Formato url/data di consultazione — norme PRIMPHD §7:
%  <url> (ultima cons. gg/mm/aaaa), senza prefisso "url:",
%  senza sottolineatura, data in italiano non in inglese
% ------------------------------------------------------------
\renewbibmacro*{url+urldate}{%
    \iffieldundef{url}{}{%
        \printtext{\textless}\printfield{url}\printtext{\textgreater}%
        \iffieldundef{urlyear}{}{%
            \addspace(ultima cons.\addspace
            \two@digits{\thefield{urlday}}/%
            \two@digits{\thefield{urlmonth}}/%
            \thefield{urlyear})}%
    }%
}

\AtEveryBibitem{%
    \clearfield{issn}%
    \clearfield{isbn}%
    \clearfield{doi}%
    \clearfield{eprint}%
    \clearfield{eprinttype}%
    \clearfield{abstract}%
    \clearfield{note}%
    \clearfield{file}%
    \clearfield{keywords}%
    \clearfield{language}%
    % url e urldate solo per risorse online
    \ifentrytype{online}{}{\clearfield{url}\clearfield{urldate}}%
}

\RequirePackage{hyperref}         % link e PDF metadata
\hypersetup{
    colorlinks  = true,
    linkcolor   = black,
    citecolor   = black,
    urlcolor    = blue
}

\graphicspath{{graphics/}}          % directory immagini

% ------------------------------------------------------------
%  Cleveref — riferimenti automatici con nome ("Appendix X")
%  Deve essere caricato dopo hyperref
% ------------------------------------------------------------
\RequirePackage{cleveref}

% ------------------------------------------------------------
%  Interruttore lingua — per sezioni con doppia versione
%  (italiano/inglese) selezionabile in fase di compilazione.
%  Uso: \iflangenglish testo in inglese \else testo italiano \fi
%  Default: inglese. Per compilare la versione italiana, cambia
%  \langenglishtrue in \langenglishfalse qui sotto.
% ------------------------------------------------------------
\newif\iflangenglish
\langenglishtrue   % <-- cambia in \langenglishfalse per output italiano

% Forza l'iniziale maiuscola per TUTTI i riferimenti, sia \cref
% che \Cref (comportamento uniforme con quello già impostato
% per le appendici, invece della convenzione standard cleveref
% dove \cref è minuscolo a metà frase e \Cref maiuscolo a inizio)
\crefname{chapter}{Chapter}{Chapters}
\Crefname{chapter}{Chapter}{Chapters}
\crefname{section}{Section}{Sections}
\Crefname{section}{Section}{Sections}
\crefname{subsection}{Subsection}{Subsections}
\Crefname{subsection}{Subsection}{Subsections}
\crefname{figure}{Figure}{Figures}
\Crefname{figure}{Figure}{Figures}
\crefname{table}{Table}{Tables}
\Crefname{table}{Table}{Tables}

% Contatore dedicato alle appendici (indipendente da section/chapter)
\newcounter{appsec}
\renewcommand{\theappsec}{\Alph{appsec}}

% Comando per dichiarare una sezione di appendice:
% incrementa il contatore, stampa "Lettera  Titolo" nello stesso
% stile (font-size, spaziatura) dei capitoli numerati, registra in indice
% \texorpdfstring evita il warning hyperref dovuto a \quad nelle stringhe PDF
% Voce di indice dedicata alle appendici:
% stesso meccanismo di \l@section (identico allineamento, peso,
% spaziatura verticale e puntini delle sezioni numerate, es. "6.1")
\newcommand*{\l@appendixsec}{\@dottedtocline{1}{1.5em}{2.3em}}

% Dichiara il livello di segnalibro PDF per il tipo "appendixsec"
% (stesso livello di \section, evita il warning hyperref/bookmark)
\providecommand\toclevel@appendixsec{1}

\newcommand{\appendixsection}[1]{%
    \refstepcounter{appsec}%
    \phantomsection
    \addcontentsline{toc}{appendixsec}{\texorpdfstring{\theappsec\quad}{\theappsec\ }#1}%
    \par\vspace{20pt}%
    {\normalfont\fontsize{15}{17}\bfseries\selectfont
        \texorpdfstring{\theappsec\quad}{\theappsec\ }#1\par}%
    \vspace{10pt}%
    \markboth{#1}{#1}%
}

\crefname{appsec}{Appendix}{Appendices}
\Crefname{appsec}{Appendix}{Appendices}

% ------------------------------------------------------------
%  Glossario — ordinamento alfabetico automatico
%  sort=standard: ordina alfabeticamente (ignora maiuscole/simboli)
%  toc: aggiunge automaticamente "Glossary" all'indice
%  nonumberlist: non stampa l'elenco delle pagine di utilizzo
%    dopo ogni voce (elenco spesso lungo e poco leggibile)
% ------------------------------------------------------------
\RequirePackage[sort=standard, toc, nonumberlist]{glossaries}
\makeglossaries

